PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/bioguard
# Long random text. Generate one:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
CLIENT_URL=http://localhost:5173

# Fusion decision thresholds (can be overridden per exam)
ACCEPT_THRESHOLD=0.75
STEPUP_THRESHOLD=0.55

# ---- The ONE administrator ----
# Only this email can ever be admin. There is no default admin password: on first start the account is
# created automatically and you log in with "Email me a login code" (a code is sent to this inbox).
ADMIN_EMAIL=
ADMIN_NAME=Administrator

# ---- Email (verification codes, login codes, invitations, alerts) ----
# Pick ONE option. Email is REQUIRED: students and teachers receive their verification and login codes here.
#
# Option A (recommended when HOSTED, works on Render/Railway): Brevo API over HTTPS, free 300 mails/day, any recipient
#   1) brevo.com > Senders > add and verify your email   2) SMTP & API > API Keys > generate
BREVO_API_KEY=
# Option B: Resend API (needs a verified domain to email other people)
RESEND_API_KEY=
# Option C (works LOCALLY; free hosts block SMTP): Gmail
#   Turn on 2-Step Verification, create an App Password, SMTP_USER = FULL Gmail address, SMTP_PASS = the 16 letters
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Sender shown on emails. With Brevo it must be a VERIFIED sender address.
MAIL_FROM=BioGuard <your-verified-address@example.com>

# ---- Security ----
# Production: set to production (hides dev codes, enforces strong settings at startup)
NODE_ENV=development
# true = admins and faculty must enter an emailed code after their password on every login
STAFF_2FA=false

# For testing WITHOUT email only (codes appear on screen). Leave false so real users can only get codes by email.
ALLOW_DEV_CODES=false
